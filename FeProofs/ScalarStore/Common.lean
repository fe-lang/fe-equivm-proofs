/-!
# FeScalarStore proof prelude (generated by `scripts/proof_skeleton.py`)

Single import point for the proof files; selector bridges, selector-word facts, and the
immutables plumbing.  Contract-specific helpers shared by several proof files go here too.
-/

open Stele ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach

namespace FeProofs.ScalarStore

set_option maxRecDepth 2000000

@[simp] theorem feScalarStoreBytecode_size : feScalarStoreBytecode.size = 80 := by
  native_decide +revert

/-- The transition list as its handles. -/
theorem transitions_eq : contract.transitions = [setTransition, getTransition] := by
  first | rfl | simp [contract, Syntax.contractSyntax]

/-! ## Selector bridges: each transition's signature hashes to its table entry -/

set_option maxHeartbeats 0 in
set_option maxRecDepth 1000000 in
/-- `selectorOf setTransition = feScalarStoreSelBytes 0` (`set(uint256)`). -/
theorem setSelectorOf : selectorOf setTransition = feScalarStoreSelBytes 0 := by
  have hsig : transitionSigStr setTransition = "set(uint256)" := by
    simp [transitionSigStr, ABI.printSignature, transitionSignature, setTransition, contract,
      Syntax.contractSyntax, ABI.abiToSigStr, ABI.elemToSigStr, ABI.intTypeToSigStr, show Nat.repr 256 = "256" by decide +kernel]
      <;> decide +kernel
  unfold selectorOf
  rw [hsig]
  exact setSelectorFact

set_option maxHeartbeats 0 in
set_option maxRecDepth 1000000 in
/-- `selectorOf getTransition = feScalarStoreSelBytes 1` (`get()`). -/
theorem getSelectorOf : selectorOf getTransition = feScalarStoreSelBytes 1 := by
  have hsig : transitionSigStr getTransition = "get()" := by
    simp [transitionSigStr, ABI.printSignature, transitionSignature, getTransition, contract,
      Syntax.contractSyntax, ABI.abiToSigStr, ABI.elemToSigStr, ABI.intTypeToSigStr, show Nat.repr 256 = "256" by decide +kernel]
      <;> decide +kernel
  unfold selectorOf
  rw [hsig]
  exact getSelectorFact

/-! ## Selector words as the dispatcher compares them -/

theorem setEvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨1627277233⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (feScalarStoreSelBytes 0 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
  evmSelectorDecode hsz 0x60 0xfe 0x47 0xb1 ⟨1627277233⟩ (by decide)

theorem getEvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨1833756220⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (feScalarStoreSelBytes 1 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
  evmSelectorDecode hsz 0x6d 0x4c 0xe6 0x3c ⟨1833756220⟩ (by decide)

end FeProofs.ScalarStore
