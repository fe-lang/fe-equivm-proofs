/-! ## Stele dispatch: which transition a selector reaches -/

theorem feScalarStoreDispatch_set {I : ExecutionEnv} 
    (hsel : selIs I (feScalarStoreSelBytes 0)) :
    dispatchMsg contract I.calldata = some setTransition := by
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := []) (post := [getTransition])
    (ti := setTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp at hu
  · rw [setSelectorOf]; exact hsel

theorem feScalarStoreDispatch_get {I : ExecutionEnv} (h0 : ¬ selIs I (feScalarStoreSelBytes 0))
    (hsel : selIs I (feScalarStoreSelBytes 1)) :
    dispatchMsg contract I.calldata = some getTransition := by
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := [setTransition]) (post := [])
    (ti := getTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hu
    rcases hu with rfl
    · rw [setSelectorOf]; exact Bool.eq_false_of_not_eq_true h0
  · rw [getSelectorOf]; exact hsel

theorem feScalarStoreDispatch_none_short {cd : ByteArray} (h : cd.size < 4) :
    dispatchMsg contract cd = none := by
  rw [dispatchMsg_eq_dispatchList contract cd, transitions_eq]
  refine dispatchList_none_short _ ?_ h
  intro t ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl
  · rw [setSelectorOf]; rfl
  · rw [getSelectorOf]; rfl

theorem feScalarStoreDispatch_none_nomatch {I : ExecutionEnv}
    (hnm : ∀ i, i < 2 → (feScalarStoreSelBytes i == I.calldata.extract 0 4) = false) :
    dispatchMsg contract I.calldata = none := by
  refine dispatchMsg_none_of_all_ne (contract := contract) (cd := I.calldata) (by rfl) (by rfl) ?_
  intro t ht
  rw [transitions_eq] at ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl
  · rw [setSelectorOf]; exact hnm 0 (by omega)
  · rw [getSelectorOf]; exact hnm 1 (by omega)

/-! ## Runtime dispatcher paths -/

/-- Dispatcher path to `set(uint256)` (arm entry pc 36). -/
theorem feScalarStoreReachSetBody {σ σ₀ A I} {g : Sat256}
    (hcode : I.code = feScalarStoreBytecode) (hsz : 4 ≤ I.calldata.size) (hsize : I.calldata.size < UInt256.size)
    (hsel : selIs I (feScalarStoreSelBytes 0)) :
    ∃ k C, RD (feScalarStoreBytecode) I g (initState σ σ₀ g A I) (UInt256.ofNat 36)
      [(UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes (⟨0⟩ : UInt256).toNat 32)) (UInt256.ofNat 224))]
      ByteArray.empty
      (UInt256.ofNat 0) ByteArray.empty σ k C := by
  have hword : solcSelectorWord I = ⟨1627277233⟩ :=
    solcSelectorWord_eq_of_beq I hsz 0x60 0xfe 0x47 0xb1 ⟨1627277233⟩ (by native_decide)
      (by simpa [feScalarStoreSelBytes] using hsel)
  have rd0 := RD.initState (g := g) (σ := σ) (σ₀ := σ₀) (A := A) hcode
  have rd1 := feScalarStoreBlocks.feScalarStore_block_0_fallthrough (by simp) (by first | exact lt_four_eq_zero_of_ge hsz hsize | exact lt_four_ne_zero_of_lt hshort | exact isZero_eq_zero_of_ne (lt_four_ne_zero_of_lt hshort) | (rw [lt_four_eq_zero_of_ge hsz hsize]; decide) | (rw [isZero_eq_zero_of_ne (lt_four_ne_zero_of_lt hshort)]; decide)) rd0
  have rd2 := feScalarStoreBlocks.feScalarStore_block_8_taken (by simp) (by simpa [solcSelectorWord] using (show (UInt256.eq (solcSelectorWord I) ⟨1627277233⟩) ≠ ⟨0⟩ by rw [hword]; native_decide)) (by jump_dest) rd1
  exact ⟨_, _, by simpa [feScalarStoreBlocks.feScalarStore_block_8_taken_stack] using rd2⟩

