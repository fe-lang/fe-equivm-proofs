/-! ## Selector words as the dispatcher compares them -/

theorem nameEvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨117300739⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (feWETH9SelBytes 0 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
  evmSelectorDecode hsz 0x06 0xfd 0xde 0x03 ⟨117300739⟩ (by decide)

