/-- Dispatcher path to `name()` (arm entry pc 137). -/
theorem feWETH9ReachNameBody {σ σ₀ A I} {g : Sat256}
    (hcode : I.code = feWETH9Bytecode) (hsz : 4 ≤ I.calldata.size) (hsize : I.calldata.size < UInt256.size)
    (hsel : selIs I (feWETH9SelBytes 0)) :
    ∃ k C, RD (feWETH9Bytecode) I g (initState σ σ₀ g A I) (UInt256.ofNat 137)
      [(UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes (⟨0⟩ : UInt256).toNat 32)) (UInt256.ofNat 224))]
      ByteArray.empty
      (UInt256.ofNat 0) ByteArray.empty σ k C := by
  have hword : solcSelectorWord I = ⟨117300739⟩ :=
    solcSelectorWord_eq_of_beq I hsz 0x06 0xfd 0xde 0x03 ⟨117300739⟩ (by native_decide)
      (by simpa [feWETH9SelBytes] using hsel)
  have rd0 := RD.initState (g := g) (σ := σ) (σ₀ := σ₀) (A := A) hcode
  rd_run rd0 to 137 using [lt_four_eq_zero_of_ge hsz hsize,
    (show UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes (⟨0⟩ : UInt256).toNat 32))
      (UInt256.ofNat 224) = ⟨117300739⟩ from hword)]
  exact ⟨_, _, rd0⟩

