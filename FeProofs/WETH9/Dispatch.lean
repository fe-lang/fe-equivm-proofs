/-! ## Runtime dispatcher paths

The entry block stores the free memory pointer (`MSTORE(0x40, 0xe0)`), so every arm starts with
`entryMem`.  The dispatcher is a binary search on the selector word (pivots `decimals()`,
`transfer(address,uint256)` and `totalSupply()`), then equality tests within a group. -/

/-- Memory at every arm's entry: the free memory pointer `0xe0` at `0x40`. -/
abbrev entryMem : ByteArray :=
  (UInt256.ofNat 224).toByteArray.write 0 ByteArray.empty (UInt256.ofNat 64).toNat 32

/-- Dispatcher path to `name()` (arm entry pc 641). -/
theorem feWETH9ReachNameBody {σ σ₀ A I} {g : Sat256}
    (hcode : I.code = feWETH9Bytecode) (hsz : 4 ≤ I.calldata.size) (hsize : I.calldata.size < UInt256.size)
    (hsel : selIs I (feWETH9SelBytes 0)) :
    ∃ aw k C, RD (feWETH9Bytecode) I g (initState σ σ₀ g A I) (UInt256.ofNat 641)
      [(UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes (⟨0⟩ : UInt256).toNat 32)) (UInt256.ofNat 224))]
      entryMem aw ByteArray.empty σ k C := by
  have hword : solcSelectorWord I = ⟨117300739⟩ :=
    solcSelectorWord_eq_of_beq I hsz 0x06 0xfd 0xde 0x03 ⟨117300739⟩ (by native_decide)
      (by simpa [feWETH9SelBytes] using hsel)
  have rd0 := RD.initState (g := g) (σ := σ) (σ₀ := σ₀) (A := A) hcode
  rd_run rd0 to 641 using [lt_four_eq_zero_of_ge hsz hsize, selWord_eq hword]
  exact ⟨_, _, _, rd0⟩

