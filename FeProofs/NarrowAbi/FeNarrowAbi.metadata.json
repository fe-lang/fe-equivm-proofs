    "FeNarrowAbi.fe": {
      "content": "use std::abi::sol\nuse std::evm::Address\n\nmsg FeNarrowAbiMsg {\n    #[selector = sol(\"echo_u8(uint8)\")]\n    EchoU8 { value: u8 } -> u8,\n    #[selector = sol(\"echo_i8(int8)\")]\n    EchoI8 { value: i8 } -> i8,\n    #[selector = sol(\"echo_bool(bool)\")]\n    EchoBool { value: bool } -> bool,\n    #[selector = sol(\"echo_address(address)\")]\n    EchoAddress { value: Address } -> Address,\n}\n\npub contract FeNarrowAbi {\n    recv FeNarrowAbiMsg {\n        EchoU8 { value } -> u8 {\n            value\n        }\n\n        EchoI8 { value } -> i8 {\n            value\n        }\n\n        EchoBool { value } -> bool {\n            value\n        }\n\n        EchoAddress { value } -> Address {\n            value\n        }\n    }\n}\n",
      "keccak256": "0x8c935432cdd29a94251bf1a8664dff4d01ce76bf00776b8cfe2963603758c30e"
