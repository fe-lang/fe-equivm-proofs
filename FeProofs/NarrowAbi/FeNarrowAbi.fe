use std::abi::sol
use std::evm::Address

msg FeNarrowAbiMsg {
    #[selector = sol("echo_u8(uint8)")]
    EchoU8 { value: u8 } -> u8,
    #[selector = sol("echo_i8(int8)")]
    EchoI8 { value: i8 } -> i8,
    #[selector = sol("echo_bool(bool)")]
    EchoBool { value: bool } -> bool,
    #[selector = sol("echo_address(address)")]
    EchoAddress { value: Address } -> Address,
}

pub contract FeNarrowAbi {
    recv FeNarrowAbiMsg {
        EchoU8 { value } -> u8 {
            value
        }

        EchoI8 { value } -> i8 {
            value
        }

        EchoBool { value } -> bool {
            value
        }

        EchoAddress { value } -> Address {
            value
        }
    }
}
