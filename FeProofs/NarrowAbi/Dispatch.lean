open Stele ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach

namespace FeProofs.NarrowAbi

set_option maxRecDepth 2000000

/-! ## Stele dispatch: which transition a selector reaches -/

theorem feNarrowAbiDispatch_echo_i8 {I : ExecutionEnv} 
    (hsel : selIs I (feNarrowAbiSelBytes 0)) :
    dispatchMsg contract I.calldata = some echo_i8Transition := by
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := []) (post := [echo_u8Transition, echo_boolTransition, echo_addressTransition])
    (ti := echo_i8Transition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp at hu
  · rw [echo_i8SelectorOf]; exact hsel

theorem feNarrowAbiDispatch_echo_u8 {I : ExecutionEnv} (h0 : ¬ selIs I (feNarrowAbiSelBytes 0))
    (hsel : selIs I (feNarrowAbiSelBytes 1)) :
    dispatchMsg contract I.calldata = some echo_u8Transition := by
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := [echo_i8Transition]) (post := [echo_boolTransition, echo_addressTransition])
    (ti := echo_u8Transition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hu
    rcases hu with rfl
    · rw [echo_i8SelectorOf]; exact Bool.eq_false_of_not_eq_true h0
  · rw [echo_u8SelectorOf]; exact hsel

theorem feNarrowAbiDispatch_echo_bool {I : ExecutionEnv} (h0 : ¬ selIs I (feNarrowAbiSelBytes 0)) (h1 : ¬ selIs I (feNarrowAbiSelBytes 1))
    (hsel : selIs I (feNarrowAbiSelBytes 2)) :
    dispatchMsg contract I.calldata = some echo_boolTransition := by
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := [echo_i8Transition, echo_u8Transition]) (post := [echo_addressTransition])
    (ti := echo_boolTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hu
    rcases hu with rfl | rfl
    · rw [echo_i8SelectorOf]; exact Bool.eq_false_of_not_eq_true h0
    · rw [echo_u8SelectorOf]; exact Bool.eq_false_of_not_eq_true h1
  · rw [echo_boolSelectorOf]; exact hsel

theorem feNarrowAbiDispatch_echo_address {I : ExecutionEnv} (h0 : ¬ selIs I (feNarrowAbiSelBytes 0)) (h1 : ¬ selIs I (feNarrowAbiSelBytes 1)) (h2 : ¬ selIs I (feNarrowAbiSelBytes 2))
    (hsel : selIs I (feNarrowAbiSelBytes 3)) :
    dispatchMsg contract I.calldata = some echo_addressTransition := by
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := [echo_i8Transition, echo_u8Transition, echo_boolTransition]) (post := [])
    (ti := echo_addressTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hu
    rcases hu with rfl | rfl | rfl
    · rw [echo_i8SelectorOf]; exact Bool.eq_false_of_not_eq_true h0
    · rw [echo_u8SelectorOf]; exact Bool.eq_false_of_not_eq_true h1
    · rw [echo_boolSelectorOf]; exact Bool.eq_false_of_not_eq_true h2
  · rw [echo_addressSelectorOf]; exact hsel

theorem feNarrowAbiDispatch_none_short {cd : ByteArray} (h : cd.size < 4) :
    dispatchMsg contract cd = none := by
  rw [dispatchMsg_eq_dispatchList contract cd, transitions_eq]
  refine dispatchList_none_short _ ?_ h
  intro t ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl
  · rw [echo_i8SelectorOf]; rfl
  · rw [echo_u8SelectorOf]; rfl
  · rw [echo_boolSelectorOf]; rfl
  · rw [echo_addressSelectorOf]; rfl

theorem feNarrowAbiDispatch_none_nomatch {I : ExecutionEnv}
    (hnm : ∀ i, i < 4 → (feNarrowAbiSelBytes i == I.calldata.extract 0 4) = false) :
    dispatchMsg contract I.calldata = none := by
  refine dispatchMsg_none_of_all_ne (contract := contract) (cd := I.calldata) (by rfl) (by rfl) ?_
  intro t ht
  rw [transitions_eq] at ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl
  · rw [echo_i8SelectorOf]; exact hnm 0 (by omega)
  · rw [echo_u8SelectorOf]; exact hnm 1 (by omega)
  · rw [echo_boolSelectorOf]; exact hnm 2 (by omega)
  · rw [echo_addressSelectorOf]; exact hnm 3 (by omega)

/-! ## Runtime dispatcher paths -/

/-- Dispatcher path to `echo_i8(int8)` (arm entry pc 56). -/
theorem feNarrowAbiReachEcho_i8Body {σ σ₀ A I} {g : Sat256}
    (hcode : I.code = feNarrowAbiBytecode) (hsz : 4 ≤ I.calldata.size) (hsize : I.calldata.size < UInt256.size)
    (hsel : selIs I (feNarrowAbiSelBytes 0)) :
    ∃ k C, RD (feNarrowAbiBytecode) I g (initState σ σ₀ g A I) (UInt256.ofNat 56)
      [(UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes (⟨0⟩ : UInt256).toNat 32)) (UInt256.ofNat 224))]
      ByteArray.empty
      (UInt256.ofNat 0) ByteArray.empty σ k C := by
  have hword : solcSelectorWord I = ⟨1192718507⟩ :=
    solcSelectorWord_eq_of_beq I hsz 0x47 0x17 0x70 0xab ⟨1192718507⟩ (by native_decide)
      (by simpa [feNarrowAbiSelBytes] using hsel)
  have rd0 := RD.initState (g := g) (σ := σ) (σ₀ := σ₀) (A := A) hcode
  rd_run rd0 to 56 using [lt_four_eq_zero_of_ge hsz hsize, selWord_eq hword]
  exact ⟨_, _, rd0⟩

