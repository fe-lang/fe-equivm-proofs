import FeProofs.NarrowAbi.Constructor
import FeProofs.NarrowAbi.Echo_i8
import FeProofs.NarrowAbi.Echo_u8
import FeProofs.NarrowAbi.Echo_bool
import FeProofs.NarrowAbi.Echo_address
import Stele.Refine

/-!
# FeNarrowAbi correctness capstone (generated by `scripts/proof_skeleton.py`)

Thin top-level: the selector case split routes each selector to its per-function `…Body`
lemma, the shared revert paths close the rest, and the constructor is packaged into the
whole-contract refinement.
-/

open Stele ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach

namespace FeProofs.NarrowAbi

set_option maxRecDepth 2000000

theorem feNarrowAbiNoDispatch {σ σ₀ A I} {g : UInt256}
    (hcode : I.code = feNarrowAbiBytecode) (hsize : I.calldata.size < UInt256.size)
    (hnm : ∀ i, i < 4 → (feNarrowAbiSelBytes i == I.calldata.extract 0 4) = false) :
    runtimeRefinementFor config contract σ σ₀ g A I := by
  by_cases hsz : 4 ≤ I.calldata.size
  · exact (feNarrowAbiX_noMatch (g := Sat256.ofUInt256 g) hcode hsz hsize hnm)
      |>.reEquivNoDispatch hcode (feNarrowAbiDispatch_none_nomatch hnm)
  · have hshort : I.calldata.size < 4 := by omega
    exact (feNarrowAbiX_short (g := Sat256.ofUInt256 g) hcode hshort)
      |>.reEquivNoDispatch hcode (feNarrowAbiDispatch_none_short hshort)

theorem feNarrowAbiNoSelectorMatches {I : ExecutionEnv}
    (h0 : ¬ selIs I (feNarrowAbiSelBytes 0)) (h1 : ¬ selIs I (feNarrowAbiSelBytes 1)) (h2 : ¬ selIs I (feNarrowAbiSelBytes 2)) (h3 : ¬ selIs I (feNarrowAbiSelBytes 3)) :
    ∀ i, i < 4 → (feNarrowAbiSelBytes i == I.calldata.extract 0 4) = false := by
  intro i hi
  interval_cases i
  · simpa [selIs] using h0
  · simpa [selIs] using h1
  · simpa [selIs] using h2
  · simpa [selIs] using h3

theorem feNarrowAbiCorrect :
    runtimeRefinement config (feNarrowAbiBytecode) contract := by
  refine ⟨fun σ σ₀ g A I hcode hsize ↦ ?_⟩
  by_cases h0 : selIs I (feNarrowAbiSelBytes 0)
  · exact feNarrowAbiEcho_i8Body hcode hsize h0
  · by_cases h1 : selIs I (feNarrowAbiSelBytes 1)
    · exact feNarrowAbiEcho_u8Body hcode hsize h1
    · by_cases h2 : selIs I (feNarrowAbiSelBytes 2)
      · exact feNarrowAbiEcho_boolBody hcode hsize h2
      · by_cases h3 : selIs I (feNarrowAbiSelBytes 3)
        · exact feNarrowAbiEcho_addressBody hcode hsize h3
        · exact feNarrowAbiNoDispatch hcode hsize (feNarrowAbiNoSelectorMatches h0 h1 h2 h3)

theorem feNarrowAbiContractCorrect :
    contractRefinement config feNarrowAbiCreationBytecode contract :=
  contractRefinement.of_constant feNarrowAbiConstructorCorrect feNarrowAbiCorrect

end FeProofs.NarrowAbi
