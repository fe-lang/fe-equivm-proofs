open Stele ABI

namespace FeProofs.NarrowAbi

def contract : ContractDecl := Syntax.contractSyntax

/-! ## Transition handles, in `contract.transitions` order -/

abbrev echo_i8Transition : TransitionDecl := contract.transitions[0]!  -- echo_i8(int8)
abbrev echo_u8Transition : TransitionDecl := contract.transitions[1]!  -- echo_u8(uint8)
abbrev echo_boolTransition : TransitionDecl := contract.transitions[2]!  -- echo_bool(bool)
abbrev echo_addressTransition : TransitionDecl := contract.transitions[3]!  -- echo_address(address)

/-! ## Storage backend: solc's layout for the declared storage -/

def storageBackend : StorageBackend := solidityStorage! [contract.structs] [contract.storage]

/-! ## Config -/

def config : Config :=
  { storageBackend := storageBackend
    externalABI := defaultExternalCallABI
    selfDeployment := genSolidityConstructorDeployment contract.ctor.params }

end FeProofs.NarrowAbi
