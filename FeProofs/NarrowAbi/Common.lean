/-!
# FeNarrowAbi proof prelude (generated by `scripts/proof_skeleton.py`)

Single import point for the proof files; selector bridges, selector-word facts, and the
immutables plumbing.  Contract-specific helpers shared by several proof files go here too.
-/

open Stele ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach

namespace FeProofs.NarrowAbi

set_option maxRecDepth 2000000

/-- The transition list as its handles. -/
theorem transitions_eq : contract.transitions = [echo_i8Transition, echo_u8Transition, echo_boolTransition, echo_addressTransition] := by
  rfl

/-! ## Selector bridges: each transition's signature hashes to its table entry -/

set_option maxHeartbeats 0 in
set_option maxRecDepth 1000000 in
/-- `selectorOf echo_i8Transition = feNarrowAbiSelBytes 0` (`echo_i8(int8)`). -/
theorem echo_i8SelectorOf : selectorOf echo_i8Transition = feNarrowAbiSelBytes 0 := by
  have hsig : transitionSigStr echo_i8Transition = "echo_i8(int8)" := by
    simp [transitionSigStr, ABI.printSignature, transitionSignature, echo_i8Transition, contract,
      Syntax.contractSyntax, ABI.abiToSigStr, ABI.elemToSigStr, ABI.intTypeToSigStr, show Nat.repr 8 = "8" by decide +kernel]
    decide +kernel
  unfold selectorOf
  rw [hsig]
  exact echo_i8SelectorFact

