/-!
# FeConstant proof prelude (generated by `scripts/proof_skeleton.py`)

Single import point for the proof files; selector bridges, selector-word facts, and the
immutables plumbing.  Contract-specific helpers shared by several proof files go here too.
-/

open Stele ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach

namespace FeProofs.Constant

set_option maxRecDepth 2000000

/-- The transition list as its handles. -/
theorem transitions_eq : contract.transitions = [answerTransition] := by
  rfl

/-! ## Selector bridges: each transition's signature hashes to its table entry -/

set_option maxHeartbeats 0 in
set_option maxRecDepth 1000000 in
/-- `selectorOf answerTransition = feConstantSelBytes 0` (`answer()`). -/
theorem answerSelectorOf : selectorOf answerTransition = feConstantSelBytes 0 := by
  have hsig : transitionSigStr answerTransition = "answer()" := by
    simp [transitionSigStr, ABI.printSignature, transitionSignature, answerTransition, contract,
      Syntax.contractSyntax]
    decide +kernel
  unfold selectorOf
  rw [hsig]
  exact answerSelectorFact

/-! ## Selector words as the dispatcher compares them -/

theorem answerEvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨2243657065⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (feConstantSelBytes 0 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
  evmSelectorDecode hsz 0x85 0xbb 0x7d 0x69 ⟨2243657065⟩ (by decide)

end FeProofs.Constant
