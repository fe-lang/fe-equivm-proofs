    UInt256.eq ⟨2835717307⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (feERC20SelBytes 4 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
