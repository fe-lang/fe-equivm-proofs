import Ethereum.Semantics
import Reasoning.Solc

/-!
# FeERC20 selectors

Generated by `scripts/scaffold.py lean`: the selector table and the selector predicate; and each
selector as the word a dispatcher compares the calldata's first word, shifted, with.
-/

open Ethereum Ethereum.EVM Reasoning.Theory

namespace FeProofs.ERC20

/-- The 4-byte selector of `I`'s calldata equals `sel`. -/
abbrev selIs (I : ExecutionEnv) (sel : ByteArray) : Prop :=
  (sel == I.calldata.extract 0 4) = true

/-- Function selectors (6 entries). -/
def feERC20SelBytes : ℕ → ByteArray
  | 0 => ⟨#[0x09, 0x5e, 0xa7, 0xb3]⟩  -- approve(address,uint256)
  | 1 => ⟨#[0x18, 0x16, 0x0d, 0xdd]⟩  -- totalSupply()
  | 2 => ⟨#[0x23, 0xb8, 0x72, 0xdd]⟩  -- transferFrom(address,address,uint256)
  | 3 => ⟨#[0x70, 0xa0, 0x82, 0x31]⟩  -- balanceOf(address)
  | 4 => ⟨#[0xa9, 0x05, 0x9c, 0xbb]⟩  -- transfer(address,uint256)
  | _ => ⟨#[0xdd, 0x62, 0xed, 0x3e]⟩  -- allowance(address,address)

/-! ## Selector words as a dispatcher compares them -/

theorem approveEvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨157198259⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (feERC20SelBytes 0 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
  evmSelectorDecode hsz 0x09 0x5e 0xa7 0xb3 ⟨157198259⟩ (by decide)

theorem totalSupplyEvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨404098525⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (feERC20SelBytes 1 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
  evmSelectorDecode hsz 0x18 0x16 0x0d 0xdd ⟨404098525⟩ (by decide)

