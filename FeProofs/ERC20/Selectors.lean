import Ethereum.Semantics
import FeProofs.Common.SelectorERC20
import Reasoning.Solc

/-!
# FeERC20 selectors

Generated by `scripts/scaffold.py lean`: the selector table in `contract.transitions` order,
the selector predicates, and one kernel-checked keccak fact per ABI signature; and each selector
as the word a dispatcher compares the calldata's first word, shifted, with.  The bridge from
each Stele transition's signature string to its entry (`transitionSigStr … = "…"`) is added by
the proof skeleton once `Spec.lean` exists.
-/

open Ethereum Ethereum.EVM Reasoning.Theory

namespace FeProofs.ERC20

/-- The 4-byte selector of `I`'s calldata equals `sel`. -/
abbrev selIs (I : ExecutionEnv) (sel : ByteArray) : Prop :=
  (sel == I.calldata.extract 0 4) = true

/-- Function selectors in `contract.transitions` order (6 entries). -/
def feERC20SelBytes : ℕ → ByteArray
  | 0 => ⟨#[0x09, 0x5e, 0xa7, 0xb3]⟩  -- approve(address,uint256)
  | 1 => ⟨#[0x18, 0x16, 0x0d, 0xdd]⟩  -- totalSupply()
  | 2 => ⟨#[0x23, 0xb8, 0x72, 0xdd]⟩  -- transferFrom(address,address,uint256)
  | 3 => ⟨#[0x70, 0xa0, 0x82, 0x31]⟩  -- balanceOf(address)
  | 4 => ⟨#[0xa9, 0x05, 0x9c, 0xbb]⟩  -- transfer(address,uint256)
  | _ => ⟨#[0xdd, 0x62, 0xed, 0x3e]⟩  -- allowance(address,address)

set_option maxHeartbeats 0
set_option maxRecDepth 1000000

/-- `keccak256("approve(address,uint256)")[0:4] = 0x095ea7b3`. -/
theorem approveSelectorFact :
    (Ethereum.KEC (String.toByteArray "approve(address,uint256)")).extract 0 4 = feERC20SelBytes 0 := by
  exact FeProofs.Common.SelectorERC20.approveSelectorHash

/-- `keccak256("totalSupply()")[0:4] = 0x18160ddd`. -/
theorem totalSupplySelectorFact :
    (Ethereum.KEC (String.toByteArray "totalSupply()")).extract 0 4 = feERC20SelBytes 1 := by
  exact FeProofs.Common.SelectorERC20.totalSupplySelectorHash

/-- `keccak256("transferFrom(address,address,uint256)")[0:4] = 0x23b872dd`. -/
theorem transferFromSelectorFact :
    (Ethereum.KEC (String.toByteArray "transferFrom(address,address,uint256)")).extract 0 4 = feERC20SelBytes 2 := by
  exact FeProofs.Common.SelectorERC20.transferFromSelectorHash

/-- `keccak256("balanceOf(address)")[0:4] = 0x70a08231`. -/
theorem balanceOfSelectorFact :
    (Ethereum.KEC (String.toByteArray "balanceOf(address)")).extract 0 4 = feERC20SelBytes 3 := by
  exact FeProofs.Common.SelectorERC20.balanceOfSelectorHash

/-- `keccak256("transfer(address,uint256)")[0:4] = 0xa9059cbb`. -/
theorem transferSelectorFact :
    (Ethereum.KEC (String.toByteArray "transfer(address,uint256)")).extract 0 4 = feERC20SelBytes 4 := by
  exact FeProofs.Common.SelectorERC20.transferSelectorHash

/-- `keccak256("allowance(address,address)")[0:4] = 0xdd62ed3e`. -/
theorem allowanceSelectorFact :
    (Ethereum.KEC (String.toByteArray "allowance(address,address)")).extract 0 4 = feERC20SelBytes 5 := by
  exact FeProofs.Common.SelectorERC20.allowanceSelectorHash

/-! ## Selector words as a dispatcher compares them -/

theorem approveEvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨157198259⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (feERC20SelBytes 0 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
  evmSelectorDecode hsz 0x09 0x5e 0xa7 0xb3 ⟨157198259⟩ (by decide)

theorem totalSupplyEvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨404098525⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (feERC20SelBytes 1 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
  evmSelectorDecode hsz 0x18 0x16 0x0d 0xdd ⟨404098525⟩ (by decide)

theorem transferFromEvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨599290589⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (feERC20SelBytes 2 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
  evmSelectorDecode hsz 0x23 0xb8 0x72 0xdd ⟨599290589⟩ (by decide)

theorem balanceOfEvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨1889567281⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (feERC20SelBytes 3 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
  evmSelectorDecode hsz 0x70 0xa0 0x82 0x31 ⟨1889567281⟩ (by decide)

theorem transferEvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨2835717307⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (feERC20SelBytes 4 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
  evmSelectorDecode hsz 0xa9 0x05 0x9c 0xbb ⟨2835717307⟩ (by decide)

theorem allowanceEvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨3714247998⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (feERC20SelBytes 5 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
  evmSelectorDecode hsz 0xdd 0x62 0xed 0x3e ⟨3714247998⟩ (by decide)

end FeProofs.ERC20
