import FeProofs.ERC20.SpecSyntax
import Stele.Semantics
import Stele.SolidityLayout
import Stele.MetaSolidityLayout
import Stele.Refine

/-!
# FeERC20 spec assembly (generated by `scripts/proof_skeleton.py`)

The contract is defined by `SpecSyntax.lean`; this file only names its parts: the transition
handles the proof files unfold, the storage backend (solc layout, from the
declarations), the external-call ABI, and the `Config`.
-/

open Stele ABI

namespace FeProofs.ERC20

def contract : ContractDecl := Syntax.contractSyntax

/-! ## Transition handles, in `contract.transitions` order -/

abbrev approveTransition : TransitionDecl := contract.transitions[0]!  -- approve(address,uint256)
abbrev totalSupplyTransition : TransitionDecl := contract.transitions[1]!  -- totalSupply()
abbrev transferFromTransition : TransitionDecl := contract.transitions[2]!  -- transferFrom(address,address,uint256)
abbrev balanceOfTransition : TransitionDecl := contract.transitions[3]!  -- balanceOf(address)
abbrev transferTransition : TransitionDecl := contract.transitions[4]!  -- transfer(address,uint256)
abbrev allowanceTransition : TransitionDecl := contract.transitions[5]!  -- allowance(address,address)

/-! ## Storage backend: solc's layout for the declared storage -/

def storageBackend : StorageBackend := solidityStorage! [contract.structs] [contract.storage]

/-! ## Config -/

def config : Config :=
  { storageBackend := storageBackend
    externalABI := defaultExternalCallABI
    selfDeployment := genSolidityConstructorDeployment contract.ctor.params }

end FeProofs.ERC20
