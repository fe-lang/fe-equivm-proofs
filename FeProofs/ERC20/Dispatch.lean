theorem feERC20Dispatch_none_short {cd : ByteArray} (h : cd.size < 4) :
    dispatchMsg contract cd = none := by
  rw [dispatchMsg_eq_dispatchList contract cd, transitions_eq]
  refine dispatchList_none_short _ ?_ h
  intro t ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl | rfl | rfl
  · rw [approveSelectorOf]; rfl
  · rw [totalSupplySelectorOf]; rfl
  · rw [transferFromSelectorOf]; rfl
  · rw [balanceOfSelectorOf]; rfl
  · rw [transferSelectorOf]; rfl
  · rw [allowanceSelectorOf]; rfl

theorem feERC20Dispatch_none_nomatch {I : ExecutionEnv}
    (hnm : ∀ i, i < 6 → (feERC20SelBytes i == I.calldata.extract 0 4) = false) :
    dispatchMsg contract I.calldata = none := by
  refine dispatchMsg_none_of_all_ne (contract := contract) (cd := I.calldata) (by rfl) (by rfl) ?_
  intro t ht
  rw [transitions_eq] at ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl | rfl | rfl
  · rw [approveSelectorOf]; exact hnm 0 (by omega)
  · rw [totalSupplySelectorOf]; exact hnm 1 (by omega)
  · rw [transferFromSelectorOf]; exact hnm 2 (by omega)
  · rw [balanceOfSelectorOf]; exact hnm 3 (by omega)
  · rw [transferSelectorOf]; exact hnm 4 (by omega)
  · rw [allowanceSelectorOf]; exact hnm 5 (by omega)

/-! ## Runtime dispatcher paths -/

/-- Dispatcher path to `approve(address,uint256)` (arm entry pc 79). -/
theorem feERC20ReachApproveBody {σ σ₀ A I} {g : Sat256}
    (hcode : I.code = feERC20Bytecode) (hsz : 4 ≤ I.calldata.size) (hsize : I.calldata.size < UInt256.size)
    (hsel : selIs I (feERC20SelBytes 0)) :
    ∃ k C, RD (feERC20Bytecode) I g (initState σ σ₀ g A I) (UInt256.ofNat 79)
      [(UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes (⟨0⟩ : UInt256).toNat 32)) (UInt256.ofNat 224))]
      ByteArray.empty
      (UInt256.ofNat 0) ByteArray.empty σ k C := by
  have hword : solcSelectorWord I = ⟨157198259⟩ :=
    solcSelectorWord_eq_of_beq I hsz 0x09 0x5e 0xa7 0xb3 ⟨157198259⟩ (by native_decide)
      (by simpa [feERC20SelBytes] using hsel)
  have rd0 := RD.initState (g := g) (σ := σ) (σ₀ := σ₀) (A := A) hcode
  rd_run rd0 to 79 using [lt_four_eq_zero_of_ge hsz hsize, selWord_eq hword]
  exact ⟨_, _, rd0⟩

