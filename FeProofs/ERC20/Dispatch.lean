theorem feERC20Dispatch_transfer {I : ExecutionEnv} (h0 : ¬ selIs I (feERC20SelBytes 0)) (h1 : ¬ selIs I (feERC20SelBytes 1)) (h2 : ¬ selIs I (feERC20SelBytes 2)) (h3 : ¬ selIs I (feERC20SelBytes 3))
