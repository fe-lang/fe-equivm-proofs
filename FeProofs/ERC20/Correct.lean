import FeProofs.ERC20.Constructor
import FeProofs.ERC20.Approve
import FeProofs.ERC20.TotalSupply
import FeProofs.ERC20.TransferFrom
import FeProofs.ERC20.BalanceOf
import FeProofs.ERC20.Transfer
import FeProofs.ERC20.Allowance
import Stele.Refine

/-!
# FeERC20 correctness capstone (generated by `scripts/proof_skeleton.py`)

Thin top-level: the selector case split routes each selector to its per-function `…Body`
lemma, the shared revert paths close the rest, and the constructor is packaged into the
whole-contract refinement.
-/

open Stele ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach

namespace FeProofs.ERC20

set_option maxRecDepth 2000000

theorem feERC20NoDispatch {σ σ₀ A I} {g : UInt256}
    (hcode : I.code = feERC20Bytecode) (hsize : I.calldata.size < UInt256.size)
    (hnm : ∀ i, i < 6 → (feERC20SelBytes i == I.calldata.extract 0 4) = false) :
    runtimeRefinementFor config contract σ σ₀ g A I := by
  by_cases hsz : 4 ≤ I.calldata.size
  · exact (feERC20X_noMatch (g := Sat256.ofUInt256 g) hcode hsz hsize hnm)
      |>.reEquivNoDispatch hcode (feERC20Dispatch_none_nomatch hnm)
  · have hshort : I.calldata.size < 4 := by omega
    exact (feERC20X_short (g := Sat256.ofUInt256 g) hcode hshort)
      |>.reEquivNoDispatch hcode (feERC20Dispatch_none_short hshort)

theorem feERC20NoSelectorMatches {I : ExecutionEnv}
    (h0 : ¬ selIs I (feERC20SelBytes 0)) (h1 : ¬ selIs I (feERC20SelBytes 1)) (h2 : ¬ selIs I (feERC20SelBytes 2)) (h3 : ¬ selIs I (feERC20SelBytes 3)) (h4 : ¬ selIs I (feERC20SelBytes 4)) (h5 : ¬ selIs I (feERC20SelBytes 5)) :
    ∀ i, i < 6 → (feERC20SelBytes i == I.calldata.extract 0 4) = false := by
  intro i hi
  interval_cases i
  · simpa [selIs] using h0
  · simpa [selIs] using h1
  · simpa [selIs] using h2
  · simpa [selIs] using h3
  · simpa [selIs] using h4
  · simpa [selIs] using h5

theorem feERC20Correct :
    runtimeRefinement config (feERC20Bytecode) contract := by
  refine ⟨fun σ σ₀ g A I hcode hsize ↦ ?_⟩
  by_cases h0 : selIs I (feERC20SelBytes 0)
  · exact feERC20ApproveBody hcode hsize h0
  · by_cases h1 : selIs I (feERC20SelBytes 1)
    · exact feERC20TotalSupplyBody hcode hsize h1
    · by_cases h2 : selIs I (feERC20SelBytes 2)
      · exact feERC20TransferFromBody hcode hsize h2
      · by_cases h3 : selIs I (feERC20SelBytes 3)
        · exact feERC20BalanceOfBody hcode hsize h3
        · by_cases h4 : selIs I (feERC20SelBytes 4)
          · exact feERC20TransferBody hcode hsize h4
          · by_cases h5 : selIs I (feERC20SelBytes 5)
            · exact feERC20AllowanceBody hcode hsize h5
            · exact feERC20NoDispatch hcode hsize (feERC20NoSelectorMatches h0 h1 h2 h3 h4 h5)

theorem feERC20ContractCorrect :
    contractRefinement config feERC20CreationBytecode contract :=
  contractRefinement.of_constant feERC20ConstructorCorrect feERC20Correct

end FeProofs.ERC20
