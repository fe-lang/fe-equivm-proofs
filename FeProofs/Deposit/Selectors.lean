import Ethereum.Semantics

/-!
# FeDeposit selectors

Generated by `scripts/scaffold.py lean`: the selector table in `contract.transitions` order,
the selector predicates, and one kernel-checked keccak fact per ABI signature.  The bridge from
each Stele transition's signature string to its entry (`transitionSigStr … = "…"`) is added by
the proof skeleton once `Spec.lean` exists.
-/

open Ethereum Ethereum.EVM

namespace FeProofs.Deposit

/-- The 4-byte selector word computed by `CALLDATALOAD(0); SHR 224`. -/
abbrev feDepositSelWord (I : ExecutionEnv) : UInt256 :=
  UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes 0 32)) ⟨224⟩

/-- The 4-byte selector of `I`'s calldata equals `sel`. -/
abbrev selIs (I : ExecutionEnv) (sel : ByteArray) : Prop :=
  (sel == I.calldata.extract 0 4) = true

/-- Function selectors in `contract.transitions` order (4 entries). -/
def feDepositSelBytes : ℕ → ByteArray
  | 0 => ⟨#[0x01, 0xff, 0xc9, 0xa7]⟩  -- supportsInterface(bytes4)
  | 1 => ⟨#[0x22, 0x89, 0x51, 0x18]⟩  -- deposit(bytes,bytes,bytes,bytes32)
  | 2 => ⟨#[0x62, 0x1f, 0xd1, 0x30]⟩  -- get_deposit_count()
  | _ => ⟨#[0xc5, 0xf2, 0x89, 0x2f]⟩  -- get_deposit_root()

set_option maxHeartbeats 0
set_option maxRecDepth 1000000

/-- `keccak256("supportsInterface(bytes4)")[0:4] = 0x01ffc9a7`. -/
theorem supportsInterfaceSelectorFact :
    (Ethereum.KEC (String.toByteArray "supportsInterface(bytes4)")).extract 0 4 = feDepositSelBytes 0 := by
  decide +kernel

/-- `keccak256("deposit(bytes,bytes,bytes,bytes32)")[0:4] = 0x22895118`. -/
theorem depositSelectorFact :
    (Ethereum.KEC (String.toByteArray "deposit(bytes,bytes,bytes,bytes32)")).extract 0 4 = feDepositSelBytes 1 := by
  decide +kernel

/-- `keccak256("get_deposit_count()")[0:4] = 0x621fd130`. -/
theorem get_deposit_countSelectorFact :
    (Ethereum.KEC (String.toByteArray "get_deposit_count()")).extract 0 4 = feDepositSelBytes 2 := by
  decide +kernel

/-- `keccak256("get_deposit_root()")[0:4] = 0xc5f2892f`. -/
theorem get_deposit_rootSelectorFact :
    (Ethereum.KEC (String.toByteArray "get_deposit_root()")).extract 0 4 = feDepositSelBytes 3 := by
  decide +kernel

end FeProofs.Deposit
