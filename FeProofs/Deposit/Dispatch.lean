set_option maxRecDepth 2000000

/-! ## Stele dispatch: which transition a selector reaches -/

theorem feDepositDispatch_supportsInterface {I : ExecutionEnv} 
    (hsel : selIs I (feDepositSelBytes 0)) :
    dispatchMsg contract I.calldata = some supportsInterfaceTransition := by
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := []) (post := [depositTransition, get_deposit_countTransition, get_deposit_rootTransition])
    (ti := supportsInterfaceTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp at hu
  · rw [supportsInterfaceSelectorOf]; exact hsel

theorem feDepositDispatch_deposit {I : ExecutionEnv}
    (hsel : selIs I (feDepositSelBytes 1)) :
    dispatchMsg contract I.calldata = some depositTransition := by
  have h0 : ¬ selIs I (feDepositSelBytes 0) := not_selIs_of_selIs hsel (by decide)
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := [supportsInterfaceTransition]) (post := [get_deposit_countTransition, get_deposit_rootTransition])
    (ti := depositTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hu
    rcases hu with rfl
    · rw [supportsInterfaceSelectorOf]; exact Bool.eq_false_of_not_eq_true h0
  · rw [depositSelectorOf]; exact hsel

theorem feDepositDispatch_get_deposit_count {I : ExecutionEnv}
    (hsel : selIs I (feDepositSelBytes 2)) :
    dispatchMsg contract I.calldata = some get_deposit_countTransition := by
  have h0 : ¬ selIs I (feDepositSelBytes 0) := not_selIs_of_selIs hsel (by decide)
  have h1 : ¬ selIs I (feDepositSelBytes 1) := not_selIs_of_selIs hsel (by decide)
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := [supportsInterfaceTransition, depositTransition]) (post := [get_deposit_rootTransition])
    (ti := get_deposit_countTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hu
    rcases hu with rfl | rfl
    · rw [supportsInterfaceSelectorOf]; exact Bool.eq_false_of_not_eq_true h0
    · rw [depositSelectorOf]; exact Bool.eq_false_of_not_eq_true h1
  · rw [get_deposit_countSelectorOf]; exact hsel

theorem feDepositDispatch_get_deposit_root {I : ExecutionEnv}
    (hsel : selIs I (feDepositSelBytes 3)) :
    dispatchMsg contract I.calldata = some get_deposit_rootTransition := by
  have h0 : ¬ selIs I (feDepositSelBytes 0) := not_selIs_of_selIs hsel (by decide)
  have h1 : ¬ selIs I (feDepositSelBytes 1) := not_selIs_of_selIs hsel (by decide)
  have h2 : ¬ selIs I (feDepositSelBytes 2) := not_selIs_of_selIs hsel (by decide)
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := [supportsInterfaceTransition, depositTransition, get_deposit_countTransition]) (post := [])
    (ti := get_deposit_rootTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hu
    rcases hu with rfl | rfl | rfl
    · rw [supportsInterfaceSelectorOf]; exact Bool.eq_false_of_not_eq_true h0
    · rw [depositSelectorOf]; exact Bool.eq_false_of_not_eq_true h1
    · rw [get_deposit_countSelectorOf]; exact Bool.eq_false_of_not_eq_true h2
  · rw [get_deposit_rootSelectorOf]; exact hsel

theorem feDepositDispatch_none_short {cd : ByteArray} (h : cd.size < 4) :
    dispatchMsg contract cd = none := by
  rw [dispatchMsg_eq_dispatchList contract cd, transitions_eq]
  refine dispatchList_none_short _ ?_ h
  intro t ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl
  · rw [supportsInterfaceSelectorOf]; rfl
  · rw [depositSelectorOf]; rfl
  · rw [get_deposit_countSelectorOf]; rfl
  · rw [get_deposit_rootSelectorOf]; rfl

theorem feDepositDispatch_none_nomatch {I : ExecutionEnv}
    (hnm : ∀ i, i < 4 → (feDepositSelBytes i == I.calldata.extract 0 4) = false) :
    dispatchMsg contract I.calldata = none := by
  refine dispatchMsg_none_of_all_ne (contract := contract) (cd := I.calldata) (by rfl) (by rfl) ?_
  intro t ht
  rw [transitions_eq] at ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl
  · rw [supportsInterfaceSelectorOf]; exact hnm 0 (by omega)
  · rw [depositSelectorOf]; exact hnm 1 (by omega)
  · rw [get_deposit_countSelectorOf]; exact hnm 2 (by omega)
  · rw [get_deposit_rootSelectorOf]; exact hnm 3 (by omega)

/-! ## Runtime dispatcher paths -/

/-- Dispatcher path to `supportsInterface(bytes4)` (arm entry pc 60, before Fe's call-value check). -/
theorem feDepositReachSupportsInterfaceBody {σ σ₀ A I} {g : Sat256}
    (hcode : I.code = feDepositBytecode) (hsz : 4 ≤ I.calldata.size) (hsize : I.calldata.size < UInt256.size)
    (hsel : selIs I (feDepositSelBytes 0)) :
    ∃ k C, RD (feDepositBytecode) I g (initState σ σ₀ g A I) (UInt256.ofNat 60)
      [(UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes (⟨0⟩ : UInt256).toNat 32)) (UInt256.ofNat 224))]
      ByteArray.empty
      (UInt256.ofNat 0) ByteArray.empty σ k C := by
  have hword : solcSelectorWord I = ⟨33540519⟩ :=
    solcSelectorWord_eq_of_beq I hsz 0x01 0xff 0xc9 0xa7 ⟨33540519⟩ (by native_decide)
      (by simpa [feDepositSelBytes] using hsel)
  have rd0 := RD.initState (g := g) (σ := σ) (σ₀ := σ₀) (A := A) hcode
  rd_run rd0 to 60 using [lt_four_eq_zero_of_ge hsz hsize, selWord_eq hword]
  exact ⟨_, _, rd0⟩

