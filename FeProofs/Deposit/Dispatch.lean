/-- Dispatcher path to `get_deposit_root()` (arm entry pc 1821). -/
theorem feDepositReachGet_deposit_rootBody {σ σ₀ A I} {g : Sat256}
    (hcode : I.code = feDepositBytecode) (hsz : 4 ≤ I.calldata.size) (hsize : I.calldata.size < UInt256.size)
    (hsel : selIs I (feDepositSelBytes 3)) :
    ∃ aw k C, RD (feDepositBytecode) I g (initState σ σ₀ g A I) (UInt256.ofNat 1821)
