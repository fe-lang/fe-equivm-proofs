/-- Calldata shorter than a selector -/
theorem feDepositX_short {σ σ₀ A I} {g : Sat256}
    (hcode : I.code = feDepositBytecode)
    (hshort : I.calldata.size < 4) :
    RDrev (feDepositBytecode) g (initState σ σ₀ g A I) := by
  have rd0 := RD.initState (g := g) (σ := σ) (σ₀ := σ₀) (A := A) hcode
  rd_run rd0 using [lt_four_ne_zero_of_lt hshort]
  exact rd0

/-- No selector matches -/
theorem feDepositX_noMatch {σ σ₀ A I} {g : Sat256}
    (hcode : I.code = feDepositBytecode)
    (hsz : 4 ≤ I.calldata.size) (hsize : I.calldata.size < UInt256.size)
    (hnm : ∀ i, i < 4 → (feDepositSelBytes i == I.calldata.extract 0 4) = false) :
    RDrev (feDepositBytecode) g (initState σ σ₀ g A I) := by
  have miss : ∀ (i : ℕ) (sel : UInt256), i < 4 →
      UInt256.eq sel (UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes 0 32)) ⟨224⟩)
        = (if (feDepositSelBytes i == I.calldata.extract 0 4) then ⟨1⟩ else ⟨0⟩) →
      UInt256.eq (entrySel I) sel = UInt256.ofNat 0 := by
    intro i sel hi e
    simp only [hnm i hi, Bool.false_eq_true, ite_false] at e
    rw [uInt256_eq_comm]
    exact e
  have e0 := miss 0 _ (by omega) (supportsInterfaceEvmSelector hsz)
  have e1 := miss 1 _ (by omega) (depositEvmSelector hsz)
  have e2 := miss 2 _ (by omega) (get_deposit_countEvmSelector hsz)
  have e3 := miss 3 _ (by omega) (get_deposit_rootEvmSelector hsz)
  have rd0 := RD.initState (g := g) (σ := σ) (σ₀ := σ₀) (A := A) hcode
  rd_run rd0 using [lt_four_eq_zero_of_ge hsz hsize, e0, e1, e2, e3]
  exact rd0

end FeProofs.Deposit
