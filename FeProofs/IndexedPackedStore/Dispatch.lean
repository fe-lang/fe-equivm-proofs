/-! ## Stele dispatch: which transition a selector reaches -/

theorem feIndexedPackedStoreDispatch_set {I : ExecutionEnv} 
    (hsel : selIs I (feIndexedPackedStoreSelBytes 0)) :
    dispatchMsg contract I.calldata = some setTransition := by
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := []) (post := [setTwoTransition, getTransition])
    (ti := setTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp at hu
  · rw [setSelectorOf]; exact hsel

theorem feIndexedPackedStoreDispatch_setTwo {I : ExecutionEnv} (h0 : ¬ selIs I (feIndexedPackedStoreSelBytes 0))
    (hsel : selIs I (feIndexedPackedStoreSelBytes 1)) :
    dispatchMsg contract I.calldata = some setTwoTransition := by
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := [setTransition]) (post := [getTransition])
    (ti := setTwoTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hu
    rcases hu with rfl
    · rw [setSelectorOf]; exact Bool.eq_false_of_not_eq_true h0
  · rw [setTwoSelectorOf]; exact hsel

theorem feIndexedPackedStoreDispatch_get {I : ExecutionEnv} (h0 : ¬ selIs I (feIndexedPackedStoreSelBytes 0)) (h1 : ¬ selIs I (feIndexedPackedStoreSelBytes 1))
    (hsel : selIs I (feIndexedPackedStoreSelBytes 2)) :
    dispatchMsg contract I.calldata = some getTransition := by
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := [setTransition, setTwoTransition]) (post := [])
    (ti := getTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hu
    rcases hu with rfl | rfl
    · rw [setSelectorOf]; exact Bool.eq_false_of_not_eq_true h0
    · rw [setTwoSelectorOf]; exact Bool.eq_false_of_not_eq_true h1
  · rw [getSelectorOf]; exact hsel

theorem feIndexedPackedStoreDispatch_none_short {cd : ByteArray} (h : cd.size < 4) :
    dispatchMsg contract cd = none := by
  rw [dispatchMsg_eq_dispatchList contract cd, transitions_eq]
  refine dispatchList_none_short _ ?_ h
  intro t ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl
  · rw [setSelectorOf]; rfl
  · rw [setTwoSelectorOf]; rfl
  · rw [getSelectorOf]; rfl

theorem feIndexedPackedStoreDispatch_none_nomatch {I : ExecutionEnv}
    (hnm : ∀ i, i < 3 → (feIndexedPackedStoreSelBytes i == I.calldata.extract 0 4) = false) :
    dispatchMsg contract I.calldata = none := by
  refine dispatchMsg_none_of_all_ne (contract := contract) (cd := I.calldata) (by rfl) (by rfl) ?_
  intro t ht
  rw [transitions_eq] at ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl
  · rw [setSelectorOf]; exact hnm 0 (by omega)
  · rw [setTwoSelectorOf]; exact hnm 1 (by omega)
  · rw [getSelectorOf]; exact hnm 2 (by omega)

