open Stele ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach

namespace FeProofs.IndexedPackedStore

set_option maxRecDepth 2000000

@[simp] theorem feIndexedPackedStoreBytecode_size : feIndexedPackedStoreBytecode.size = 422 := by
  native_decide +revert

/-- The transition list as its handles. -/
theorem transitions_eq : contract.transitions = [setTransition, setTwoTransition, getTransition] := by
  first | rfl | simp [contract, Syntax.contractSyntax]

/-! ## Selector bridges: each transition's signature hashes to its table entry -/

set_option maxHeartbeats 0 in
set_option maxRecDepth 1000000 in
/-- `selectorOf setTransition = feIndexedPackedStoreSelBytes 0` (`set(uint256,uint256)`). -/
theorem setSelectorOf : selectorOf setTransition = feIndexedPackedStoreSelBytes 0 := by
  have hsig : transitionSigStr setTransition = "set(uint256,uint256)" := by
    simp [transitionSigStr, ABI.printSignature, transitionSignature, setTransition, contract,
      Syntax.contractSyntax, ABI.abiToSigStr, ABI.elemToSigStr, ABI.intTypeToSigStr, show Nat.repr 256 = "256" by decide +kernel]
      <;> decide +kernel
  unfold selectorOf
  rw [hsig]
  exact setSelectorFact

set_option maxHeartbeats 0 in
set_option maxRecDepth 1000000 in
/-- `selectorOf setTwoTransition = feIndexedPackedStoreSelBytes 1` (`setTwo(uint256,uint256,uint256,uint256)`). -/
theorem setTwoSelectorOf : selectorOf setTwoTransition = feIndexedPackedStoreSelBytes 1 := by
  have hsig : transitionSigStr setTwoTransition = "setTwo(uint256,uint256,uint256,uint256)" := by
    simp [transitionSigStr, ABI.printSignature, transitionSignature, setTwoTransition, contract,
      Syntax.contractSyntax, ABI.abiToSigStr, ABI.elemToSigStr, ABI.intTypeToSigStr, show Nat.repr 256 = "256" by decide +kernel]
      <;> decide +kernel
  unfold selectorOf
