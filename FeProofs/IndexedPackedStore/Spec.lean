import FeProofs.IndexedPackedStore.SpecSyntax
import Stele.Semantics
import Stele.SolidityLayout
import Stele.MetaSolidityLayout
import Stele.Refine
import FeProofs.Common.PackedByte

/-!
# FeIndexedPackedStore spec assembly (generated by `scripts/proof_skeleton.py`)

The contract is defined by `SpecSyntax.lean`; this file only names its parts: the transition
handles the proof files unfold, the storage backend (solc layout, from the
declarations), the external-call ABI, and the `Config`.
-/

open Stele ABI

namespace FeProofs.IndexedPackedStore

def contract : ContractDecl := Syntax.contractSyntax

/-! ## Transition handles, in `contract.transitions` order -/

abbrev setTransition : TransitionDecl := contract.transitions[0]!  -- set(uint256,uint256)
abbrev setTwoTransition : TransitionDecl := contract.transitions[1]!  -- setTwo(uint256,uint256,uint256,uint256)
abbrev getTransition : TransitionDecl := contract.transitions[2]!  -- get(uint256)

/-! ## Storage layout: Fe's `StoragePackedArray<8>` at slot 0

Fe does not use solc's layout for this field: word `w` of the array is at `keccak256(0) + w`, and
element `i` is byte `i % 32` of word `i / 32`.  `uint8[64] pack` names the first 64 elements. -/

/-- `keccak256(0)`, the first word of the packed array whose place is slot 0. -/
def packedSlot : Ethereum.UInt256 :=
  ⟨18569430475105882587588266137607568536673111973893317399460219858819262702947⟩

/-- The word and byte of element `i`. -/
def elemLoc (i : Nat) : StorageLoc :=
  FeProofs.packedByteLoc (packedSlot + Ethereum.UInt256.ofNat (i / 32))
    ⟨i % 32, Nat.mod_lt _ (by decide)⟩

def storageLayout : StorageLayout
  | { base := "pack", steps := [.aindex (.int i)] } =>
      if 0 ≤ i ∧ i < 64 then some (.leaf (elemLoc i.toNat)) else none
  | _ => none

def storageBackend : StorageBackend := solidityStorageBackend storageLayout

/-! ## Config -/

def config : Config :=
  { storageBackend := storageBackend
    externalABI := defaultExternalCallABI
    selfDeployment := genSolidityConstructorDeployment contract.ctor.params }

end FeProofs.IndexedPackedStore
