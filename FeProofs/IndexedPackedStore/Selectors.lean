import Ethereum.Semantics

/-!
# FeIndexedPackedStore selectors

Generated by `scripts/scaffold.py lean`: the selector table in `contract.transitions` order,
the selector predicates, and one kernel-checked keccak fact per ABI signature.  The bridge from
each Stele transition's signature string to its entry (`transitionSigStr … = "…"`) is added by
the proof skeleton once `Spec.lean` exists.
-/

open Ethereum Ethereum.EVM

namespace FeProofs.IndexedPackedStore

/-- The 4-byte selector word computed by `CALLDATALOAD(0); SHR 224`. -/
abbrev feIndexedPackedStoreSelWord (I : ExecutionEnv) : UInt256 :=
  UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes 0 32)) ⟨224⟩

/-- The 4-byte selector of `I`'s calldata equals `sel`. -/
abbrev selIs (I : ExecutionEnv) (sel : ByteArray) : Prop :=
  (sel == I.calldata.extract 0 4) = true

/-- Function selectors in `contract.transitions` order (3 entries). -/
def feIndexedPackedStoreSelBytes : ℕ → ByteArray
  | 0 => ⟨#[0x1a, 0xb0, 0x6e, 0xe5]⟩  -- set(uint256,uint256)
  | 1 => ⟨#[0x62, 0xe3, 0xd8, 0x7d]⟩  -- setTwo(uint256,uint256,uint256,uint256)
  | _ => ⟨#[0x95, 0x07, 0xd3, 0x9a]⟩  -- get(uint256)

set_option maxHeartbeats 0
set_option maxRecDepth 1000000

/-- `keccak256("set(uint256,uint256)")[0:4] = 0x1ab06ee5`. -/
theorem setSelectorFact :
    (Ethereum.KEC (String.toByteArray "set(uint256,uint256)")).extract 0 4 = feIndexedPackedStoreSelBytes 0 := by
  decide +kernel

/-- `keccak256("setTwo(uint256,uint256,uint256,uint256)")[0:4] = 0x62e3d87d`. -/
theorem setTwoSelectorFact :
    (Ethereum.KEC (String.toByteArray "setTwo(uint256,uint256,uint256,uint256)")).extract 0 4 = feIndexedPackedStoreSelBytes 1 := by
  decide +kernel

/-- `keccak256("get(uint256)")[0:4] = 0x9507d39a`. -/
theorem getSelectorFact :
    (Ethereum.KEC (String.toByteArray "get(uint256)")).extract 0 4 = feIndexedPackedStoreSelBytes 2 := by
  decide +kernel

end FeProofs.IndexedPackedStore
