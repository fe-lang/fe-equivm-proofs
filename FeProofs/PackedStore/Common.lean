/-! ## Selector words as the dispatcher compares them -/

theorem get1EvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨88873589⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (fePackedStoreSelBytes 0 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
  evmSelectorDecode hsz 0x05 0x4c 0x1a 0x75 ⟨88873589⟩ (by decide)

theorem get0EvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
