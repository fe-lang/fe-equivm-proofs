open Stele ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach

namespace FeProofs.PackedStore

set_option maxRecDepth 2000000

@[simp] theorem fePackedStoreBytecode_size : fePackedStoreBytecode.size = 489 := by
  native_decide +revert

/-- The transition list as its handles. -/
theorem transitions_eq : contract.transitions = [get1Transition, get0Transition, setBothTransition, set1Transition, set0Transition] := by
  first | rfl | simp [contract, Syntax.contractSyntax]

/-! ## Selector bridges: each transition's signature hashes to its table entry -/

set_option maxHeartbeats 0 in
set_option maxRecDepth 1000000 in
/-- `selectorOf get1Transition = fePackedStoreSelBytes 0` (`get1()`). -/
theorem get1SelectorOf : selectorOf get1Transition = fePackedStoreSelBytes 0 := by
  have hsig : transitionSigStr get1Transition = "get1()" := by
    simp [transitionSigStr, ABI.printSignature, transitionSignature, get1Transition, contract,
      Syntax.contractSyntax, ABI.abiToSigStr, ABI.elemToSigStr, ABI.intTypeToSigStr, show Nat.repr 256 = "256" by decide +kernel]
      <;> decide +kernel
  unfold selectorOf
  rw [hsig]
  exact get1SelectorFact

