import FeProofs.PackedStore.SpecSyntax
import Stele.Semantics
import Stele.SolidityLayout
import Stele.MetaSolidityLayout
import Stele.Refine
import FeProofs.Common.PackedByte

/-!
# FePackedStore spec assembly (generated by `scripts/proof_skeleton.py`)

The contract is defined by `SpecSyntax.lean`; this file only names its parts: the transition
handles the proof files unfold, the storage backend (solc layout, from the
declarations), the external-call ABI, and the `Config`.
-/

open Stele ABI

namespace FeProofs.PackedStore

def contract : ContractDecl := Syntax.contractSyntax

/-! ## Transition handles, in `contract.transitions` order -/

abbrev get1Transition : TransitionDecl := contract.transitions[0]!  -- get1()
abbrev get0Transition : TransitionDecl := contract.transitions[1]!  -- get0()
abbrev setBothTransition : TransitionDecl := contract.transitions[2]!  -- setBoth(uint256,uint256)
abbrev set1Transition : TransitionDecl := contract.transitions[3]!  -- set1(uint256)
abbrev set0Transition : TransitionDecl := contract.transitions[4]!  -- set0(uint256)

/-! ## Storage layout: Fe's `StoragePackedArray<8>` at slot 0

Fe does not use solc's layout for this field: the array's words start at `keccak256(0)`, and lane
`i` is byte `i` of the first word.  `lane0`/`lane1` name lanes 0 and 1. -/

/-- `keccak256(0)`, the first word of the packed array whose place is slot 0. -/
def packedSlot : Ethereum.UInt256 :=
  ⟨18569430475105882587588266137607568536673111973893317399460219858819262702947⟩

def storageLayout : StorageLayout
  | { base := "lane0", steps := [] } => some (.leaf (FeProofs.packedByteLoc packedSlot 0))
  | { base := "lane1", steps := [] } => some (.leaf (FeProofs.packedByteLoc packedSlot 1))
  | _ => none

def storageBackend : StorageBackend := solidityStorageBackend storageLayout

/-! ## Config -/

def config : Config :=
  { storageBackend := storageBackend
    externalABI := defaultExternalCallABI
    selfDeployment := genSolidityConstructorDeployment contract.ctor.params }

end FeProofs.PackedStore
