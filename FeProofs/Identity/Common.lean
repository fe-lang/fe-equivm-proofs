/-!
# FeIdentity proof prelude (generated by `scripts/proof_skeleton.py`)

Single import point for the proof files; selector bridges, selector-word facts, and the
immutables plumbing.  Contract-specific helpers shared by several proof files go here too.
-/

open Stele ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach

namespace FeProofs.Identity

set_option maxRecDepth 2000000

@[simp] theorem feIdentityBytecode_size : feIdentityBytecode.size = 58 := by
  native_decide +revert

/-- The transition list as its handles. -/
theorem transitions_eq : contract.transitions = [identityTransition] := by
  first | rfl | simp [contract, Syntax.contractSyntax]

/-! ## Selector bridges: each transition's signature hashes to its table entry -/

set_option maxHeartbeats 0 in
set_option maxRecDepth 1000000 in
/-- `selectorOf identityTransition = feIdentitySelBytes 0` (`identity(uint256)`). -/
theorem identitySelectorOf : selectorOf identityTransition = feIdentitySelBytes 0 := by
  have hsig : transitionSigStr identityTransition = "identity(uint256)" := by
    simp [transitionSigStr, ABI.printSignature, transitionSignature, identityTransition, contract,
      Syntax.contractSyntax, ABI.abiToSigStr, ABI.elemToSigStr, ABI.intTypeToSigStr, show Nat.repr 256 = "256" by decide +kernel]
      <;> decide +kernel
  unfold selectorOf
  rw [hsig]
  exact identitySelectorFact

/-! ## Selector words as the dispatcher compares them -/

theorem identityEvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨2889346747⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (feIdentitySelBytes 0 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
  evmSelectorDecode hsz 0xac 0x37 0xee 0xbb ⟨2889346747⟩ (by decide)

end FeProofs.Identity
