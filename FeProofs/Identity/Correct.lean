import FeProofs.Identity.Constructor
import FeProofs.Identity.Identity
import Stele.Refine

/-!
# FeIdentity correctness capstone (generated by `scripts/proof_skeleton.py`)

Thin top-level: the selector case split routes each selector to its per-function `…Body`
lemma, the shared revert paths close the rest, and the constructor is packaged into the
whole-contract refinement.
-/

open Stele ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach

namespace FeProofs.Identity

set_option maxRecDepth 2000000

theorem feIdentityNoDispatch {σ σ₀ A I} {g : UInt256}
    (hcode : I.code = feIdentityBytecode) (hsize : I.calldata.size < UInt256.size)
    (hnm : ∀ i, i < 1 → (feIdentitySelBytes i == I.calldata.extract 0 4) = false) :
    runtimeRefinementFor config contract σ σ₀ g A I := by
  by_cases hsz : 4 ≤ I.calldata.size
  · exact (feIdentityX_noMatch (g := Sat256.ofUInt256 g) hcode hsz hsize hnm)
      |>.reEquivNoDispatch hcode (feIdentityDispatch_none_nomatch hnm)
  · have hshort : I.calldata.size < 4 := by omega
    exact (feIdentityX_short (g := Sat256.ofUInt256 g) hcode hshort)
      |>.reEquivNoDispatch hcode (feIdentityDispatch_none_short hshort)

theorem feIdentityNoSelectorMatches {I : ExecutionEnv}
    (h0 : ¬ selIs I (feIdentitySelBytes 0)) :
    ∀ i, i < 1 → (feIdentitySelBytes i == I.calldata.extract 0 4) = false := by
  intro i hi
  interval_cases i
  · simpa [selIs] using h0

theorem feIdentityCorrect :
    runtimeRefinement config (feIdentityBytecode) contract := by
  refine ⟨fun σ σ₀ g A I hcode hsize ↦ ?_⟩
  by_cases h0 : selIs I (feIdentitySelBytes 0)
  · exact feIdentityIdentityBody hcode hsize h0
  · exact feIdentityNoDispatch hcode hsize (feIdentityNoSelectorMatches h0)

theorem feIdentityContractCorrect :
    contractRefinement config feIdentityCreationBytecode contract :=
  contractRefinement.of_constant feIdentityConstructorCorrect feIdentityCorrect

end FeProofs.Identity
