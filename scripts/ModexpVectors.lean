def main : IO Unit := do
  let mut agree := 0
  let mut disagree := 0
  for (name, i, o) in geth do
    match model (Diff.hex i) with
    | .ok (some m) =>
      if m == Diff.hex o then agree := agree + 1 else
        disagree := disagree + 1
        IO.println s!"DISAGREE {name}: model {Ethereum.toHex m}, go-ethereum {o}"
    | .ok none =>
      disagree := disagree + 1
      IO.println s!"DISAGREE {name}: the model fails, go-ethereum {o}"
    | .error how =>
      disagree := disagree + 1
      IO.println s!"DISAGREE {name}: the model {how}"
  IO.println s!"MODEXP: {geth.length} go-ethereum vectors; {agree} agree, {disagree} disagree"

end ModexpVectors

#eval ModexpVectors.main
